<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="StepsCounter.Pages.StepCounterPage"
             Title="Step Counter"
             BackgroundColor="#F8FAFC">

    <ScrollView>
        <VerticalStackLayout Padding="25"
                             Spacing="25">

            <!-- Header -->
            <VerticalStackLayout Spacing="5">
                <Label Text="Step Counter"
                       FontSize="28"
                       FontAttributes="Bold"
                       TextColor="#111827"
                       HorizontalOptions="Center"/>

                <Label Text="Track your daily activity"
                       FontSize="14"
                       TextColor="#6B7280"
                       HorizontalOptions="Center"/>
            </VerticalStackLayout>

            <!-- Main Step Card -->
            <Border Stroke="#E5E7EB"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 24"
                    BackgroundColor="White"
                    Padding="25">

                <VerticalStackLayout HorizontalOptions="Center"
                                     Spacing="15">

                    <!-- Circular Step Indicator -->
                    <Border WidthRequest="180"
                            HeightRequest="180"
                            Stroke="#4F46E5"
                            StrokeThickness="4"
                            BackgroundColor="#EEF2FF"
                            StrokeShape="RoundRectangle 90"
                            HorizontalOptions="Center">

                        <VerticalStackLayout VerticalOptions="Center"
                                             HorizontalOptions="Center"
                                             Spacing="4">

                            <Label Text="🚶"
                                   FontSize="50"
                                   HorizontalOptions="Center"/>

                            <Label Text="{Binding StepCount}"
                                   FontSize="42"
                                   FontAttributes="Bold"
                                   TextColor="#16A34A"
                                   HorizontalOptions="Center"/>

                            <Label Text="Steps"
                                   FontSize="14"
                                   TextColor="#6B7280"
                                   HorizontalOptions="Center"/>

                        </VerticalStackLayout>

                    </Border>

                    <!-- Status -->
                    <Label Text="{Binding StatusMessage}"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="{Binding StatusColor}"
                           HorizontalOptions="Center"/>

                </VerticalStackLayout>

            </Border>

            <!-- Warning Card -->
            <Border Stroke="#FCA5A5"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 16"
                    BackgroundColor="#FEF2F2"
                    Padding="12"
                    IsVisible="{Binding IsNotSupported}">

                <Label Text="⚠️ Pedometer is not supported on this device"
                       FontSize="13"
                       TextColor="#DC2626"
                       HorizontalOptions="Center"/>
            </Border>

            <!-- Action Buttons -->
            <Grid ColumnDefinitions="*,*"
                  ColumnSpacing="15">

                <Button Grid.Column="0"
                        Text="Start"
                        Command="{Binding StartCommand}"
                        IsEnabled="{Binding CanStart}"
                        HeightRequest="55"
                        CornerRadius="14"
                        FontAttributes="Bold"
                        BackgroundColor="#4F46E5"
                        TextColor="White"/>

                <Button Grid.Column="1"
                        Text="Stop"
                        Command="{Binding StopCommand}"
                        IsEnabled="{Binding CanStop}"
                        HeightRequest="55"
                        CornerRadius="14"
                        FontAttributes="Bold"
                        BackgroundColor="#EF4444"
                        TextColor="White"/>

            </Grid>

            <!-- Reset Button -->
            <Button Text="Reset Counter"
                    Command="{Binding ResetCommand}"
                    HeightRequest="55"
                    CornerRadius="14"
                    FontAttributes="Bold"
                    BackgroundColor="White"
                    BorderColor="#D1D5DB"
                    BorderWidth="1"
                    TextColor="#374151"/>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>